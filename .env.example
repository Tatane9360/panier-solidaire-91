# Copier en .env et adapter. Aucun secret réel dans ce fichier.

NODE_ENV=development
PORT=3000

# Base de l'application et base de test (remise à zéro par les tests)
DATABASE_URL=postgres://panier:panier@localhost:5432/panier
TEST_DATABASE_URL=postgres://panier:panier@localhost:5432/panier_test

# E-mails (Mailpit en local) ; APP_URL sert aux liens des e-mails
APP_URL=http://localhost:3000
MAIL_FROM=Panier Solidaire 91 <ne-pas-repondre@example.org>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# Durée d'inactivité avant expiration de la session, en minutes
SESSION_DURATION_MINUTES=30
# Taille de page du suivi des lots
PAGE_SIZE=50

# Script d'installation : territoire pilote et premier compte Coordination
TERRITORY_NAME=Essonne
COORDINATOR_EMAIL=coordination@example.org
COORDINATOR_PASSWORD=change-moi
COORDINATOR_ORGANIZATION_NAME=Panier Solidaire 91
COORDINATOR_ADDRESS=Adresse de la Coordination
